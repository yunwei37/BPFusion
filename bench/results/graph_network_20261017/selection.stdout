{"utc": "2026-10-17T05:22:33.601729+00:00", "source": "\"\"\"Deterministic screen-only selection; never use confirmation outcomes to retune.\"\"\"\nfrom pathlib import Path\nimport argparse,datetime,json\ndef main(root):\n    groups={}\n    for p in (root/\"screen\").glob(\"*.metrics.json\"):\n        m=json.loads(p.read_text());key=(m[\"operation\"],m[\"repeat\"],m[\"cores\"],m[\"offered_rate\"])\n        assert m[\"mode\"] not in groups.setdefault(key,{})\n        groups[key][m[\"mode\"]]=m\n    eligible=[];all_rows=[]\n    for key,paths in sorted(groups.items()):\n        reasons=[]\n        if set(paths)!={\"kernel\",\"native\"}:reasons.append(\"unmatched rate\")\n        for mode,m in paths.items():\n            if m[\"failures\"]:reasons.append(mode+\" failures\")\n            if m[\"throughput\"]<.98*m[\"offered_rate\"]:reasons.append(mode+\" attained<98%\")\n            if not m[\"group_stable\"] or m[\"owned_group_cpu_ms_per_attempt\"] is None:reasons.append(mode+\" unstable group\")\n            if not m[\"service_affinity_verified\"]:reasons.append(mode+\" affinity not verified\")\n            tail=m[\"latency\"][\"scheduled_response_ms\"];timer=m[\"latency\"][\"timer_dispatch_lag_ms\"]\n            if tail is None or timer is None:reasons.append(mode+\" missing complete tail/monitor\")\n            elif timer[\"p99\"]>max(1,.1*tail[\"p99\"]):reasons.append(mode+\" timer-dispatch lag\")\n            if m[\"owned_group_cpu_ms_per_attempt\"] is not None and m[\"owned_group_cpu_ms_per_attempt\"]<=0:\n                reasons.append(mode+\" nonpositive measured CPU\")\n        item=dict(operation=key[0],repeat=key[1],cores=key[2],rate=key[3],eligible=not reasons,reasons=reasons)\n        if not reasons:\n            k,n=paths[\"kernel\"],paths[\"native\"]\n            item[\"cpu_ratio\"]=k[\"owned_group_cpu_ms_per_attempt\"]/n[\"owned_group_cpu_ms_per_attempt\"]\n            item[\"p99_ratio\"]=k[\"latency\"][\"scheduled_response_ms\"][\"p99\"]/n[\"latency\"][\"scheduled_response_ms\"][\"p99\"]\n            eligible.append(item)\n        all_rows.append(item)\n    assert groups,\"no complete screening data\"\n    selected=[]\n    if eligible:\n        for label,cores,metric in [(\"unrestricted_cpu\",0,\"cpu_ratio\"),(\"unrestricted_tail\",0,\"p99_ratio\"),(\"one_cpu\",1,\"cpu_ratio\")]:\n            candidates=[x for x in eligible if x[\"cores\"]==cores]\n            if not candidates:continue\n            best=min(candidates,key=lambda x:(x[metric],x[\"repeat\"],x[\"operation\"],x[\"rate\"]))\n            key=(best[\"operation\"],best[\"repeat\"],best[\"cores\"],best[\"rate\"])\n            if key not in [(x[\"operation\"],x[\"repeat\"],x[\"cores\"],x[\"rate\"]) for x in selected]:\n                selected.append(dict(best,selection=label))\n    if not selected:\n        selected=[dict(operation=op,repeat=1,cores=cores,rate=1000,selection=\"prespecified negative-boundary fallback\")\n                  for op,cores in [(\"matmul\",0),(\"fft\",0),(\"matmul\",1)]]\n    result=dict(utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),source=Path(__file__).read_text(),\n                candidate_cells=all_rows,selected=selected,confirmation_seconds=20,pairs=5,\n                seed_rule=\"420261017+selection_index*100+pair; identical both paths; distinct from screening\",\n                order_rule=\"kernel,native for even(pair+selection_index), native,kernel otherwise\")\n    (root/\"confirmation_selection.json\").write_text(json.dumps(result,indent=2))\n    print(json.dumps(result))\nif __name__==\"__main__\":\n    ap=argparse.ArgumentParser();ap.add_argument(\"root\",type=Path);main(ap.parse_args().root)\n", "candidate_cells": [{"operation": "fft", "repeat": 1, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 0.9415279083129916, "p99_ratio": 0.17249834564026398}, {"operation": "fft", "repeat": 1, "cores": 0, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.2517686022621866, "p99_ratio": 1.1045874224412489}, {"operation": "fft", "repeat": 1, "cores": 0, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}, {"operation": "fft", "repeat": 1, "cores": 1, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 1.0988540672805747, "p99_ratio": 4.154610404096064}, {"operation": "fft", "repeat": 1, "cores": 1, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.1583461288852686, "p99_ratio": 0.2662185733379523}, {"operation": "fft", "repeat": 1, "cores": 1, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}, {"operation": "fft", "repeat": 1, "cores": 2, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 1.2074774411430491, "p99_ratio": 0.8128789893068067}, {"operation": "fft", "repeat": 1, "cores": 2, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.191778276407143, "p99_ratio": 40.47957125580231}, {"operation": "fft", "repeat": 1, "cores": 2, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}, {"operation": "fft", "repeat": 16, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 1.0367927420067244, "p99_ratio": 7.7142106742449785}, {"operation": "fft", "repeat": 16, "cores": 0, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.2049650111156855, "p99_ratio": 0.2600724094032077}, {"operation": "fft", "repeat": 16, "cores": 0, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}, {"operation": "fft", "repeat": 256, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 1.0370886241880108, "p99_ratio": 1.1103387870766153}, {"operation": "fft", "repeat": 256, "cores": 0, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.2514197405695968, "p99_ratio": 40.61390013495219}, {"operation": "fft", "repeat": 256, "cores": 0, "rate": 16000, "eligible": false, "reasons": ["kernel attained<98%", "native attained<98%"]}, {"operation": "matmul", "repeat": 1, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 0.9624403442710848, "p99_ratio": 0.11528512227975764}, {"operation": "matmul", "repeat": 1, "cores": 0, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.2128588805672043, "p99_ratio": 58.82898617130511}, {"operation": "matmul", "repeat": 1, "cores": 0, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}, {"operation": "matmul", "repeat": 1, "cores": 1, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 1.0641575743217522, "p99_ratio": 6.756550767374798}, {"operation": "matmul", "repeat": 1, "cores": 1, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.2157394080540582, "p99_ratio": 5.350259702579678}, {"operation": "matmul", "repeat": 1, "cores": 1, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}, {"operation": "matmul", "repeat": 1, "cores": 2, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 1.0939508679492407, "p99_ratio": 1.736850793544217}, {"operation": "matmul", "repeat": 1, "cores": 2, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.1823025659224677, "p99_ratio": 4.309656824608442}, {"operation": "matmul", "repeat": 1, "cores": 2, "rate": 16000, "eligible": false, "reasons": ["kernel attained<98%", "native attained<98%"]}, {"operation": "matmul", "repeat": 16, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 0.9443185855867926, "p99_ratio": 3.0634463646751553}, {"operation": "matmul", "repeat": 16, "cores": 0, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.1987216665063227, "p99_ratio": 0.19540618833531287}, {"operation": "matmul", "repeat": 16, "cores": 0, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}, {"operation": "matmul", "repeat": 256, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 0.9797309000242836, "p99_ratio": 1.2026435985669326}, {"operation": "matmul", "repeat": 256, "cores": 0, "rate": 4000, "eligible": true, "reasons": [], "cpu_ratio": 1.2523588023842853, "p99_ratio": 0.2037339716881256}, {"operation": "matmul", "repeat": 256, "cores": 0, "rate": 16000, "eligible": false, "reasons": ["native attained<98%", "kernel attained<98%"]}], "selected": [{"operation": "fft", "repeat": 1, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 0.9415279083129916, "p99_ratio": 0.17249834564026398, "selection": "unrestricted_cpu"}, {"operation": "matmul", "repeat": 1, "cores": 0, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 0.9624403442710848, "p99_ratio": 0.11528512227975764, "selection": "unrestricted_tail"}, {"operation": "matmul", "repeat": 1, "cores": 1, "rate": 1000, "eligible": true, "reasons": [], "cpu_ratio": 1.0641575743217522, "p99_ratio": 6.756550767374798, "selection": "one_cpu"}], "confirmation_seconds": 20, "pairs": 5, "seed_rule": "420261017+selection_index*100+pair; identical both paths; distinct from screening", "order_rule": "kernel,native for even(pair+selection_index), native,kernel otherwise"}
