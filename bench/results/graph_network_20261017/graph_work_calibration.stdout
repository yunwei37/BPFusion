{"event": "calibration", "source": "#!/usr/bin/env python3\n# SPDX-License-Identifier: Apache-2.0\n\"\"\"CUDA-event host-replay calibration; not an isolated device-launch timing.\"\"\"\nimport importlib.util,json,platform,time\nfrom pathlib import Path\nimport torch\nr=Path(__file__).resolve().parents[1]\nspec=importlib.util.spec_from_file_location(\"graph_example\",r/\"examples/torch_graph_server.py\")\nexample=importlib.util.module_from_spec(spec);spec.loader.exec_module(example)\nresult=dict(event=\"calibration\",source=Path(__file__).read_text(),example_source=(r/\"examples/torch_graph_server.py\").read_text(),\n            torch=torch.__version__,cuda=torch.version.cuda,device=torch.cuda.get_device_name(0),platform=platform.platform(),cells=[])\nfor operation in [\"matmul\",\"fft\"]:\n    for repeat in [1,16,256]:\n        graphs,inputs,outputs,weights=example.capture_graphs(operation,8,repeat)\n        for _ in range(3):graphs[0].replay()\n        torch.cuda.synchronize()\n        elapsed=[]\n        for block in range(5):\n            start=torch.cuda.Event(enable_timing=True);end=torch.cuda.Event(enable_timing=True)\n            start.record()\n            for _ in range(100):graphs[0].replay()\n            end.record();end.synchronize();elapsed.append(start.elapsed_time(end)*1000/100)\n        result[\"cells\"].append(dict(operation=operation,repeat=repeat,host_replay_event_us_per_graph=elapsed,\n          note=\"CUDA-event batch elapsed includes host submission gaps; no request latency or pure isolated-kernel claim. Served graphs have no timing nodes.\"))\n        del graphs,inputs,outputs,weights\nprint(json.dumps(result))\n", "example_source": "#!/usr/bin/env python3\n# SPDX-License-Identifier: Apache-2.0\n\"\"\"Capture upstream cuBLAS/cuFFT graphs and hand opaque buffers to BPFusion.\n\nUse the existing TCP/HTTP frame, with input and output lengths both 64.\nWords represent IEEE float32 bit patterns, without numeric conversion.\nMatmul: row-major 8x8 FP32 input times fixed W[i,j]=(8*i+j)%7-3.\nFFT: 32 complex64 values, interleaved real/imaginary FP32 words.\n\"\"\"\nimport argparse\nimport ctypes\nfrom pathlib import Path\nimport torch\n\ndef capture_graphs(operation,slots,repeat=1):\n    graphs=[];inputs=[];outputs=[];weights=[]\n    stream=torch.cuda.Stream()\n    with torch.cuda.stream(stream),torch.inference_mode():\n        for _ in range(slots):\n            if operation==\"matmul\":\n                x=torch.zeros((8,8),device=\"cuda\",dtype=torch.float32)\n                weight=(torch.arange(64,device=\"cuda\",dtype=torch.float32)%7-3).reshape(8,8)\n                y=torch.empty_like(x)\n                def run(): torch.mm(x,weight,out=y)\n                weights.append(weight)\n            else:\n                x=torch.zeros(32,device=\"cuda\",dtype=torch.complex64)\n                y=torch.empty_like(x)\n                def run(): torch.fft.fft(x,out=y)\n            for _ in range(3): run()\n            graph=torch.cuda.CUDAGraph(keep_graph=True)\n            with torch.cuda.graph(graph,stream=stream):\n                for _ in range(repeat): run()\n            graphs.append(graph);inputs.append(x);outputs.append(y)\n    stream.synchronize()\n    return graphs,inputs,outputs,weights\n\ndef main():\n    parser=argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"library\",type=Path)\n    parser.add_argument(\"operation\",choices=[\"matmul\",\"fft\"])\n    parser.add_argument(\"--seconds\",type=int,default=3600)\n    parser.add_argument(\"--repeat\",type=int,default=1,help=\"library operations per captured graph; input/output unchanged\")\n    args=parser.parse_args()\n    if args.seconds<=0: parser.error(\"--seconds must be positive\")\n    if args.repeat<=0: parser.error(\"--repeat must be positive\")\n    lib=ctypes.CDLL(str(args.library.resolve()))\n    for name in [\"bf_graph_abi_version\",\"bf_graph_max_slots\",\"bf_graph_max_words\"]:\n        getattr(lib,name).restype=ctypes.c_uint\n    if lib.bf_graph_abi_version()!=1: raise RuntimeError(\"unsupported graph ABI\")\n    if lib.bf_graph_max_words()<64: raise RuntimeError(\"example needs 64 words\")\n    slots=lib.bf_graph_max_slots()\n    graphs,inputs,outputs,weights=capture_graphs(args.operation,slots,args.repeat)\n    Array=ctypes.c_uint64*slots\n    graph_ptrs=Array(*(g.raw_cuda_graph() for g in graphs))\n    input_ptrs=Array(*(x.data_ptr() for x in inputs))\n    output_ptrs=Array(*(y.data_ptr() for y in outputs))\n    lib.bf_graph_serve.argtypes=[ctypes.POINTER(ctypes.c_uint64)]*3+[ctypes.c_uint]*3\n    lib.bf_graph_serve.restype=ctypes.c_int\n    result=lib.bf_graph_serve(graph_ptrs,input_ptrs,output_ptrs,64,64,args.seconds)\n    if result: raise SystemExit(result)\n\nif __name__==\"__main__\":\n    main()\n", "torch": "2.13.0+cu129", "cuda": "12.9", "device": "NVIDIA GeForce RTX 5090", "platform": "Linux-7.3.0-070300rc3-generic-x86_64-with-glibc2.39", "cells": [{"operation": "matmul", "repeat": 1, "host_replay_event_us_per_graph": [2.4569599330425262, 2.455040067434311, 2.3824000358581543, 2.417919933795929, 2.377920001745224], "note": "CUDA-event batch elapsed includes host submission gaps; no request latency or pure isolated-kernel claim. Served graphs have no timing nodes."}, {"operation": "matmul", "repeat": 16, "host_replay_event_us_per_graph": [20.530240535736084, 20.497920513153076, 20.51232099533081, 20.524799823760986, 20.50816059112549], "note": "CUDA-event batch elapsed includes host submission gaps; no request latency or pure isolated-kernel claim. Served graphs have no timing nodes."}, {"operation": "matmul", "repeat": 256, "host_replay_event_us_per_graph": [317.6198387145996, 317.61791229248047, 317.61152267456055, 317.6188850402832, 317.5984001159668], "note": "CUDA-event batch elapsed includes host submission gaps; no request latency or pure isolated-kernel claim. Served graphs have no timing nodes."}, {"operation": "fft", "repeat": 1, "host_replay_event_us_per_graph": [4.129279851913452, 4.114559888839722, 4.085440039634705, 4.082559943199158, 4.084799885749817], "note": "CUDA-event batch elapsed includes host submission gaps; no request latency or pure isolated-kernel claim. Served graphs have no timing nodes."}, {"operation": "fft", "repeat": 16, "host_replay_event_us_per_graph": [28.703999519348145, 28.717761039733887, 28.701438903808594, 28.684799671173096, 28.739840984344482], "note": "CUDA-event batch elapsed includes host submission gaps; no request latency or pure isolated-kernel claim. Served graphs have no timing nodes."}, {"operation": "fft", "repeat": 256, "host_replay_event_us_per_graph": [434.03072357177734, 434.0089416503906, 434.0224075317383, 434.0089416503906, 434.0163040161133], "note": "CUDA-event batch elapsed includes host submission gaps; no request latency or pure isolated-kernel claim. Served graphs have no timing nodes."}]}
