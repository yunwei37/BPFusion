include /workspaces/repository/Makefile

.PHONY: original-baselines
original-baselines: $(BUILD)/vllm_graph_uring_loop_coalesced_original.so $(BUILD)/vllm_graph_uring_loop_coalesced_original

$(BUILD)/vllm_graph_uring_loop_coalesced_original.so: /tmp/bpfusion-final-drain-woo07fic/original/executor/vllm_graph.cu /tmp/bpfusion-final-drain-woo07fic/original/executor/io_uring_tcp.h | $(BUILD)
	$(NVCC) -O3 -std=c++17 -arch=$(SM_ARCH) --cudart=none -dc -Xcompiler=-fPIC -Ibpf/include -DBF_URING_NETWORK -DBF_URING_BPF_LOOP -DBF_IO_COALESCED -I$(KERNEL_UAPI) -DBF_PAD_PREFILL -DBF_PREFIX_RELEASE $< -o $@.o
	$(NVCC) -arch=$(SM_ARCH) -dlink -Xcompiler=-fPIC $@.o -o $@.dlink.o
	$(CXX) -shared -Wl,-z,defs $@.o $@.dlink.o $(VLLM_CUDART) -Wl,-rpath,$(dir $(VLLM_CUDART)) -o $@ $(LDLIBS)

$(BUILD)/vllm_graph_uring_loop_coalesced_original: executor/vllm_graph.py
	ln -sf $(abspath executor/vllm_graph.py) $@
